# CareerPilot AI Configuration

# Database (defaults to local SQLite if left empty or pointed to sqlite:///./careerpilot.db)
DATABASE_URL=postgresql://careerpilot:careerpilot_password@localhost:5432/careerpilot_db

# LLM Configuration (Optional: system provides deterministic fallback interview prep if key is not provided)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

